# macOS and editor state
.DS_Store
*.swp
*.swo
*~

# Local environment and caches
.env
.venv/
.cache/
__pycache__/
.pytest_cache/

# Simulator scratch and large waveform databases
*.raw
*.tr0
*.ac0
*.sw0
*.mt0
*.lis
*.log
!results/smoke/xschem/*.log
!results/smoke/xschem/**/*.log
!experiments/day5/raw/*.log
!experiments/day5/retained_failures/**/*.log
experiments/day5/.run.lock/
experiments/day5/.run-backup.*/
experiments/day5/failed_runs/
*.bak

# Deterministically regenerated SPICE decks
results/generated/*
!results/generated/.gitkeep
!results/generated/day4/
results/generated/day4/*
!results/generated/day4/day4_manifest.json

# Layout/editor backup files
*.mag~
*.sch~

# Generated report intermediates
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# Keep parsed CSV summaries and curated plots under version control. Large raw
# outputs should be archived externally and referenced by checksum/path.

# GitHub checkpoint: local usage outputs and compiled simulator artifacts
outputs/
*_obj_dir/
*.o
*.so
*.a
*.d
*.odb

# Original school reports and host metadata remain local.
/cadence/project1/reports/**/received/
/cadence/project1/reports/**/*.zip
/cadence/project1/reports/**/cadence_pdk_index.json
/cadence/project1/reports/**/cadence_report.txt
/cadence/project1/reports/**/cadence_report_share.txt
/cadence/project1/reports/**/cadence_tools.json
/cadence/project1/reports/**/linux_report.json


* Day 3: complete two-stage Miller-compensated OTA, nominal loop-gain bench.
* DC feedback is retained through a huge inductor.  At AC, that path is open
* and a huge coupling capacitor drives VINN from a 1-V AC source.  Therefore
* T=-V(VOUT)/V(VINN) is the return ratio for the opened unity-feedback loop.

.lib "@@MODEL_DECK@@" @@CORNER@@
.temp 27

.param VDDVAL=1.8 VCMVAL=0.9 IREFVAL=10u RLOAD=100k CLOAD=5p
.param W12=16.83798 L12=0.5
.param W34UNIT=25 L34=0.5
.param W5=25.8754 L5=0.8
.param W6=@@W6_UM@@ L6=0.5
.param W7=72.2005 L7=0.8
.param W8=7.22005 L8=0.8
.param W9=7.22005 L9=0.8
.param W10=8.08605 L10=0.8
.param CC=@@CC_F@@ RZ=@@RZ_OHM@@

VDD vdd 0 {VDDVAL}
IREF vbp 0 {IREFVAL}
VINP vinp 0 DC {VCMVAL} AC 0
VTEST vtest 0 DC 0 AC 1

* DC-closed / AC-open unity-feedback break.
LBREAK vout vinn 1G
CBREAK vtest vinn 1G

RLOAD1 vout 0 {RLOAD}
CLOAD1 vout 0 {CLOAD}

* Single-IREF bias tree.
XM8  vbp  vbp vdd vdd sky130_fd_pr__pfet_01v8 L={L8}  W={W8}  nf=1 mult=1
XM9  vbn  vbp vdd vdd sky130_fd_pr__pfet_01v8 L={L9}  W={W9}  nf=1 mult=1
XM10 vbn  vbn 0   0   sky130_fd_pr__nfet_01v8 L={L10} W={W10} nf=1 mult=1

* M1/M2 input pair and M3/M4 two-unit mirror load from the Day 2 iteration.
* M1 senses VINN; M2 senses VINP.  M6 provides the second inversion.
XM1 nmir vinn tail 0 sky130_fd_pr__nfet_01v8 L={L12} W={W12} nf=1 mult=1
XM2 vx   vinp tail 0 sky130_fd_pr__nfet_01v8 L={L12} W={W12} nf=1 mult=1
XM3A nmir nmir vdd vdd sky130_fd_pr__pfet_01v8 L={L34} W={W34UNIT} nf=1 mult=1
XM3B nmir nmir vdd vdd sky130_fd_pr__pfet_01v8 L={L34} W={W34UNIT} nf=1 mult=1
XM4A vx   nmir vdd vdd sky130_fd_pr__pfet_01v8 L={L34} W={W34UNIT} nf=1 mult=1
XM4B vx   nmir vdd vdd sky130_fd_pr__pfet_01v8 L={L34} W={W34UNIT} nf=1 mult=1
XM5 tail vbn  0   0   sky130_fd_pr__nfet_01v8 L={L5} W={W5} nf=1 mult=1

XM6 vout vx  0   0   sky130_fd_pr__nfet_01v8 L={L6} W={W6} nf=1 mult=1
XM7 vout vbp vdd vdd sky130_fd_pr__pfet_01v8 L={L7} W={W7} nf=1 mult=1

* Series nulling resistor and Miller capacitor.
RZ1 vx ncc {RZ}
CC1 ncc vout {CC}

.save all
.save i(VDD)
.save @m.xm1.msky130_fd_pr__nfet_01v8[id] @m.xm1.msky130_fd_pr__nfet_01v8[gm] @m.xm1.msky130_fd_pr__nfet_01v8[gds] @m.xm1.msky130_fd_pr__nfet_01v8[vdsat]
.save @m.xm2.msky130_fd_pr__nfet_01v8[id] @m.xm2.msky130_fd_pr__nfet_01v8[gm] @m.xm2.msky130_fd_pr__nfet_01v8[gds] @m.xm2.msky130_fd_pr__nfet_01v8[vdsat]
.save @m.xm3a.msky130_fd_pr__pfet_01v8[id] @m.xm3a.msky130_fd_pr__pfet_01v8[gm] @m.xm3a.msky130_fd_pr__pfet_01v8[gds] @m.xm3a.msky130_fd_pr__pfet_01v8[vdsat]
.save @m.xm3b.msky130_fd_pr__pfet_01v8[id] @m.xm3b.msky130_fd_pr__pfet_01v8[gm] @m.xm3b.msky130_fd_pr__pfet_01v8[gds]
.save @m.xm4a.msky130_fd_pr__pfet_01v8[id] @m.xm4a.msky130_fd_pr__pfet_01v8[gm] @m.xm4a.msky130_fd_pr__pfet_01v8[gds] @m.xm4a.msky130_fd_pr__pfet_01v8[vdsat]
.save @m.xm4b.msky130_fd_pr__pfet_01v8[id] @m.xm4b.msky130_fd_pr__pfet_01v8[gm] @m.xm4b.msky130_fd_pr__pfet_01v8[gds]
.save @m.xm5.msky130_fd_pr__nfet_01v8[id] @m.xm5.msky130_fd_pr__nfet_01v8[gm] @m.xm5.msky130_fd_pr__nfet_01v8[gds] @m.xm5.msky130_fd_pr__nfet_01v8[vdsat]
.save @m.xm6.msky130_fd_pr__nfet_01v8[id] @m.xm6.msky130_fd_pr__nfet_01v8[gm] @m.xm6.msky130_fd_pr__nfet_01v8[gds] @m.xm6.msky130_fd_pr__nfet_01v8[vdsat]
.save @m.xm7.msky130_fd_pr__pfet_01v8[id] @m.xm7.msky130_fd_pr__pfet_01v8[gm] @m.xm7.msky130_fd_pr__pfet_01v8[gds] @m.xm7.msky130_fd_pr__pfet_01v8[vdsat]
.save @m.xm8.msky130_fd_pr__pfet_01v8[id] @m.xm8.msky130_fd_pr__pfet_01v8[gm] @m.xm8.msky130_fd_pr__pfet_01v8[gds] @m.xm8.msky130_fd_pr__pfet_01v8[vdsat]
.save @m.xm9.msky130_fd_pr__pfet_01v8[id] @m.xm9.msky130_fd_pr__pfet_01v8[gm] @m.xm9.msky130_fd_pr__pfet_01v8[gds] @m.xm9.msky130_fd_pr__pfet_01v8[vdsat]
.save @m.xm10.msky130_fd_pr__nfet_01v8[id] @m.xm10.msky130_fd_pr__nfet_01v8[gm] @m.xm10.msky130_fd_pr__nfet_01v8[gds] @m.xm10.msky130_fd_pr__nfet_01v8[vdsat]

.control
set noaskquit
set wr_singlescale
set wr_vecnames

op
let m1_id=abs(@m.xm1.msky130_fd_pr__nfet_01v8[id])
let m1_gm=abs(@m.xm1.msky130_fd_pr__nfet_01v8[gm])
let m1_gds=abs(@m.xm1.msky130_fd_pr__nfet_01v8[gds])
let m1_vdsat=abs(@m.xm1.msky130_fd_pr__nfet_01v8[vdsat])
let m2_id=abs(@m.xm2.msky130_fd_pr__nfet_01v8[id])
let m2_gm=abs(@m.xm2.msky130_fd_pr__nfet_01v8[gm])
let m2_gds=abs(@m.xm2.msky130_fd_pr__nfet_01v8[gds])
let m2_vdsat=abs(@m.xm2.msky130_fd_pr__nfet_01v8[vdsat])
let m3_id=abs(@m.xm3a.msky130_fd_pr__pfet_01v8[id])+abs(@m.xm3b.msky130_fd_pr__pfet_01v8[id])
let m3_gm=abs(@m.xm3a.msky130_fd_pr__pfet_01v8[gm])+abs(@m.xm3b.msky130_fd_pr__pfet_01v8[gm])
let m3_gds=abs(@m.xm3a.msky130_fd_pr__pfet_01v8[gds])+abs(@m.xm3b.msky130_fd_pr__pfet_01v8[gds])
let m3_vdsat=abs(@m.xm3a.msky130_fd_pr__pfet_01v8[vdsat])
let m4_id=abs(@m.xm4a.msky130_fd_pr__pfet_01v8[id])+abs(@m.xm4b.msky130_fd_pr__pfet_01v8[id])
let m4_gm=abs(@m.xm4a.msky130_fd_pr__pfet_01v8[gm])+abs(@m.xm4b.msky130_fd_pr__pfet_01v8[gm])
let m4_gds=abs(@m.xm4a.msky130_fd_pr__pfet_01v8[gds])+abs(@m.xm4b.msky130_fd_pr__pfet_01v8[gds])
let m4_vdsat=abs(@m.xm4a.msky130_fd_pr__pfet_01v8[vdsat])
let m5_id=abs(@m.xm5.msky130_fd_pr__nfet_01v8[id])
let m5_gm=abs(@m.xm5.msky130_fd_pr__nfet_01v8[gm])
let m5_gds=abs(@m.xm5.msky130_fd_pr__nfet_01v8[gds])
let m5_vdsat=abs(@m.xm5.msky130_fd_pr__nfet_01v8[vdsat])
let m6_id=abs(@m.xm6.msky130_fd_pr__nfet_01v8[id])
let m6_gm=abs(@m.xm6.msky130_fd_pr__nfet_01v8[gm])
let m6_gds=abs(@m.xm6.msky130_fd_pr__nfet_01v8[gds])
let m6_vdsat=abs(@m.xm6.msky130_fd_pr__nfet_01v8[vdsat])
let m7_id=abs(@m.xm7.msky130_fd_pr__pfet_01v8[id])
let m7_gm=abs(@m.xm7.msky130_fd_pr__pfet_01v8[gm])
let m7_gds=abs(@m.xm7.msky130_fd_pr__pfet_01v8[gds])
let m7_vdsat=abs(@m.xm7.msky130_fd_pr__pfet_01v8[vdsat])
let m8_id=abs(@m.xm8.msky130_fd_pr__pfet_01v8[id])
let m8_gm=abs(@m.xm8.msky130_fd_pr__pfet_01v8[gm])
let m8_gds=abs(@m.xm8.msky130_fd_pr__pfet_01v8[gds])
let m8_vdsat=abs(@m.xm8.msky130_fd_pr__pfet_01v8[vdsat])
let m9_id=abs(@m.xm9.msky130_fd_pr__pfet_01v8[id])
let m9_gm=abs(@m.xm9.msky130_fd_pr__pfet_01v8[gm])
let m9_gds=abs(@m.xm9.msky130_fd_pr__pfet_01v8[gds])
let m9_vdsat=abs(@m.xm9.msky130_fd_pr__pfet_01v8[vdsat])
let m10_id=abs(@m.xm10.msky130_fd_pr__nfet_01v8[id])
let m10_gm=abs(@m.xm10.msky130_fd_pr__nfet_01v8[gm])
let m10_gds=abs(@m.xm10.msky130_fd_pr__nfet_01v8[gds])
let m10_vdsat=abs(@m.xm10.msky130_fd_pr__nfet_01v8[vdsat])
let idd=abs(i(VDD))
wrdata results/raw/day3/@@TAG@@_op.tsv v(vout) v(vx) v(vbn) v(vbp) v(tail) v(nmir) v(vinp) v(vinn) idd m1_id m1_gm m1_gds m1_vdsat m2_id m2_gm m2_gds m2_vdsat m3_id m3_gm m3_gds m3_vdsat m4_id m4_gm m4_gds m4_vdsat m5_id m5_gm m5_gds m5_vdsat m6_id m6_gm m6_gds m6_vdsat m7_id m7_gm m7_gds m7_vdsat m8_id m8_gm m8_gds m8_vdsat m9_id m9_gm m9_gds m9_vdsat m10_id m10_gm m10_gds m10_vdsat

ac dec 120 1 1G
let tloop=-v(vout)/v(vinn)
let gain_db=db(tloop)
let phase_raw_deg=180/pi*ph(tloop)
wrdata results/raw/day3/@@TAG@@_loop.tsv gain_db phase_raw_deg

quit
.endc

.end

* Day 4 full-OTA ICMR point: DC closed-loop, AC differential open-loop.
* VCM=@@VCM_V@@ V
* DAY4_MANIFEST_SHA256=@@MANIFEST_SHA256@@
.lib "@@PDK_LIB_PATH@@" tt
.temp 27
.include "results/generated/day4/ota_subckt.spice"

VSSSUP VSS 0 0
VDD VDD VSS 1.8
IREF VBP VSS 10u
VINP VINP VSS DC @@VCM_V@@ AC 0.5
VNEG VNEG VSS DC 0 AC -0.5
LBREAK VOUT VINN 1G
CBREAK VNEG VINN 1G
RLOAD VOUT VSS 100k
CLOAD VOUT VSS 5p
XOTA VDD VSS VINP VINN VOUT VBP SKY130_TWO_STAGE_OTA

.control
set noaskquit
set wr_singlescale
set wr_vecnames
op
let m1_id=abs(@m.xota.xm1.msky130_fd_pr__nfet_01v8[id])
let m1_vdsat=abs(@m.xota.xm1.msky130_fd_pr__nfet_01v8[vdsat])
let m2_id=abs(@m.xota.xm2.msky130_fd_pr__nfet_01v8[id])
let m2_vdsat=abs(@m.xota.xm2.msky130_fd_pr__nfet_01v8[vdsat])
let m3_id=abs(@m.xota.xm3a.msky130_fd_pr__pfet_01v8[id])+abs(@m.xota.xm3b.msky130_fd_pr__pfet_01v8[id])
let m3_vdsat=abs(@m.xota.xm3a.msky130_fd_pr__pfet_01v8[vdsat])
let m4_id=abs(@m.xota.xm4a.msky130_fd_pr__pfet_01v8[id])+abs(@m.xota.xm4b.msky130_fd_pr__pfet_01v8[id])
let m4_vdsat=abs(@m.xota.xm4a.msky130_fd_pr__pfet_01v8[vdsat])
let m5_id=abs(@m.xota.xm5.msky130_fd_pr__nfet_01v8[id])
let m5_vdsat=abs(@m.xota.xm5.msky130_fd_pr__nfet_01v8[vdsat])
let m6_id=abs(@m.xota.xm6.msky130_fd_pr__nfet_01v8[id])
let m6_vdsat=abs(@m.xota.xm6.msky130_fd_pr__nfet_01v8[vdsat])
let m7_id=abs(@m.xota.xm7.msky130_fd_pr__pfet_01v8[id])
let m7_vdsat=abs(@m.xota.xm7.msky130_fd_pr__pfet_01v8[vdsat])
let m8_id=abs(@m.xota.xm8.msky130_fd_pr__pfet_01v8[id])
let m8_vdsat=abs(@m.xota.xm8.msky130_fd_pr__pfet_01v8[vdsat])
let m9_id=abs(@m.xota.xm9.msky130_fd_pr__pfet_01v8[id])
let m9_vdsat=abs(@m.xota.xm9.msky130_fd_pr__pfet_01v8[vdsat])
let m10_id=abs(@m.xota.xm10.msky130_fd_pr__nfet_01v8[id])
let m10_vdsat=abs(@m.xota.xm10.msky130_fd_pr__nfet_01v8[vdsat])
wrdata @@RAW_PREFIX@@_op.tsv v(VOUT) v(XOTA.VX) v(XOTA.VBN) v(VBP) v(XOTA.TAIL) v(XOTA.NMIR) m1_id m1_vdsat m2_id m2_vdsat m3_id m3_vdsat m4_id m4_vdsat m5_id m5_vdsat m6_id m6_vdsat m7_id m7_vdsat m8_id m8_vdsat m9_id m9_vdsat m10_id m10_vdsat
ac dec 10 1 10
let vdiff=v(VINP)-v(VINN)
let ad=v(VOUT)/vdiff
wrdata @@RAW_PREFIX@@_ac.tsv ad vdiff
quit
.endc
.end

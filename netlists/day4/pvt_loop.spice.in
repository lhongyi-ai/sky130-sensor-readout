* Day 4 return-ratio and operating-point test.
* DAY4_MANIFEST_SHA256=@@MANIFEST_SHA256@@
.lib "@@PDK_LIB_PATH@@" @@CORNER@@
.temp @@TEMP_C@@
.include "results/generated/day4/ota_subckt.spice"

VSSSUP VSS 0 0
VDD VDD VSS @@VDD_V@@
IREF VBP VSS 10u
VINP VINP VSS DC 0.9 AC 0
VTEST VTEST VSS DC 0 AC 1
* Production return-ratio method inherited from the validated Day 3 bench.
LBREAK VOUT VINN 1G
CBREAK VTEST VINN 1G
RLOAD VOUT VSS 100k
CLOAD VOUT VSS @@CLOAD_PF@@p
XOTA VDD VSS VINP VINN VOUT VBP SKY130_TWO_STAGE_OTA

.save all
.save i(VDD)
.control
set noaskquit
set wr_singlescale
set wr_vecnames
op
let ivdd_signed=i(VDD)
let idd=abs(ivdd_signed)
let m1_id=abs(@m.xota.xm1.msky130_fd_pr__nfet_01v8[id])
let m1_gm=abs(@m.xota.xm1.msky130_fd_pr__nfet_01v8[gm])
let m1_gds=abs(@m.xota.xm1.msky130_fd_pr__nfet_01v8[gds])
let m1_vdsat=abs(@m.xota.xm1.msky130_fd_pr__nfet_01v8[vdsat])
let m2_id=abs(@m.xota.xm2.msky130_fd_pr__nfet_01v8[id])

let m2_vdsat=abs(@m.xota.xm2.msky130_fd_pr__nfet_01v8[vdsat])
let m3_id=abs(@m.xota.xm3a.msky130_fd_pr__pfet_01v8[id])+abs(@m.xota.xm3b.msky130_fd_pr__pfet_01v8[id])
let m3_gm=abs(@m.xota.xm3a.msky130_fd_pr__pfet_01v8[gm])+abs(@m.xota.xm3b.msky130_fd_pr__pfet_01v8[gm])
let m3_gds=abs(@m.xota.xm3a.msky130_fd_pr__pfet_01v8[gds])+abs(@m.xota.xm3b.msky130_fd_pr__pfet_01v8[gds])
let m3_vdsat=abs(@m.xota.xm3a.msky130_fd_pr__pfet_01v8[vdsat])
let m4_id=abs(@m.xota.xm4a.msky130_fd_pr__pfet_01v8[id])+abs(@m.xota.xm4b.msky130_fd_pr__pfet_01v8[id])
let m4_gm=abs(@m.xota.xm4a.msky130_fd_pr__pfet_01v8[gm])+abs(@m.xota.xm4b.msky130_fd_pr__pfet_01v8[gm])
let m4_gds=abs(@m.xota.xm4a.msky130_fd_pr__pfet_01v8[gds])+abs(@m.xota.xm4b.msky130_fd_pr__pfet_01v8[gds])
let m4_vdsat=abs(@m.xota.xm4a.msky130_fd_pr__pfet_01v8[vdsat])
let m5_id=abs(@m.xota.xm5.msky130_fd_pr__nfet_01v8[id])
let m5_gm=abs(@m.xota.xm5.msky130_fd_pr__nfet_01v8[gm])
let m5_gds=abs(@m.xota.xm5.msky130_fd_pr__nfet_01v8[gds])
let m5_vdsat=abs(@m.xota.xm5.msky130_fd_pr__nfet_01v8[vdsat])
let m6_id=abs(@m.xota.xm6.msky130_fd_pr__nfet_01v8[id])
let m6_gm=abs(@m.xota.xm6.msky130_fd_pr__nfet_01v8[gm])
let m6_gds=abs(@m.xota.xm6.msky130_fd_pr__nfet_01v8[gds])
let m6_vdsat=abs(@m.xota.xm6.msky130_fd_pr__nfet_01v8[vdsat])
let m7_id=abs(@m.xota.xm7.msky130_fd_pr__pfet_01v8[id])
let m7_gm=abs(@m.xota.xm7.msky130_fd_pr__pfet_01v8[gm])
let m7_gds=abs(@m.xota.xm7.msky130_fd_pr__pfet_01v8[gds])
let m7_vdsat=abs(@m.xota.xm7.msky130_fd_pr__pfet_01v8[vdsat])
let m8_id=abs(@m.xota.xm8.msky130_fd_pr__pfet_01v8[id])
let m8_gm=abs(@m.xota.xm8.msky130_fd_pr__pfet_01v8[gm])
let m8_gds=abs(@m.xota.xm8.msky130_fd_pr__pfet_01v8[gds])
let m8_vdsat=abs(@m.xota.xm8.msky130_fd_pr__pfet_01v8[vdsat])

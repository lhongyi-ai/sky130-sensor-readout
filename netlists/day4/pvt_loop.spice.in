let m10_vdsat=abs(@m.xota.xm10.msky130_fd_pr__nfet_01v8[vdsat])
wrdata @@RAW_PREFIX@@_op.tsv v(VOUT) v(XOTA.VX) v(XOTA.VBN) v(VBP) v(XOTA.TAIL) v(XOTA.NMIR) v(VINP) v(VINN) ivdd_signed idd m1_id m1_gm m1_gds m1_vdsat m2_id m2_gm m2_gds m2_vdsat m3_id m3_gm m3_gds m3_vdsat m4_id m4_gm m4_gds m4_vdsat m5_id m5_gm m5_gds m5_vdsat m6_id m6_gm m6_gds m6_vdsat m7_id m7_gm m7_gds m7_vdsat m8_id m8_gm m8_gds m8_vdsat m9_id m9_gm m9_gds m9_vdsat m10_id m10_gm m10_gds m10_vdsat
ac dec 120 1 1G
let tloop=-v(VOUT)/v(VINN)
wrdata @@RAW_PREFIX@@_loop.tsv tloop v(VINN) v(VOUT)
quit
.endc
.end

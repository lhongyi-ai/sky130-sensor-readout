* SKY130A standard-VT NFET characterization at VDS = 0.9 V.
* Generated from this template; do not edit files under results/generated.

.lib "@@MODEL_DECK@@" @@CORNER@@
.temp 27
.param WCH=5 LCH=@@LENGTH_UM@@

VGS gate 0 0
VDS drain 0 0.9
XMN drain gate 0 0 sky130_fd_pr__nfet_01v8 L={LCH} W={WCH} nf=1 mult=1

.save @m.xmn.msky130_fd_pr__nfet_01v8[id]
.save @m.xmn.msky130_fd_pr__nfet_01v8[gm]
.save @m.xmn.msky130_fd_pr__nfet_01v8[gds]
.save @m.xmn.msky130_fd_pr__nfet_01v8[vth]
.save @m.xmn.msky130_fd_pr__nfet_01v8[vdsat]

.control
set noaskquit
set wr_singlescale
set wr_vecnames
dc VGS 0 1.8 0.01
let id_abs = abs(@m.xmn.msky130_fd_pr__nfet_01v8[id])
let gm_abs = abs(@m.xmn.msky130_fd_pr__nfet_01v8[gm])
let gds_abs = abs(@m.xmn.msky130_fd_pr__nfet_01v8[gds])
let vth_abs = abs(@m.xmn.msky130_fd_pr__nfet_01v8[vth])
let vdsat_abs = abs(@m.xmn.msky130_fd_pr__nfet_01v8[vdsat])
let gm_id = gm_abs / id_abs
let gm_gds = gm_abs / gds_abs
wrdata results/raw/day1/nfet_characterization_l@@LENGTH_TAG@@.tsv id_abs gm_abs gds_abs vth_abs vdsat_abs gm_id gm_gds
quit
.endc

.end

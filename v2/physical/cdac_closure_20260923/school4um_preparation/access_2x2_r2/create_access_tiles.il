; New isolated MIM structure. Tested APIs from installed IC618 docs.
procedure(p2c4QuadLayout(name rects pins)
 let((cv fig net term pin pt half result)
  when(ddGetObj("project1" name) error("Refuse existing target: %s" name))
  cv=dbOpenCellViewByType("project1" name "layout" "maskLayout" "w")
  unless(cv error("Cannot create %s" name))
  dbReplaceProp(cv "p1maOwner" "string" "cdac4_shared_access_r2")
  dbReplaceProp(cv "p1maStatus" "string" "EXPERIMENT_NOT_QUALIFIED")
  foreach(row rects
   unless(dbCreateRect(cv list(car(row) cadr(row)) list(caddr(row) cadddr(row)))
    dbSave(cv) error("Failed rectangle")))
  foreach(row pins
   net=dbMakeNet(cv car(row))
   term=dbCreateTerm(net car(row) "inputOutput")
   pt=caddr(row)
   half=0.01
   fig=dbCreateRect(cv list(cadr(row) "pin")
    list(list(xCoord(pt)-half yCoord(pt)-half) list(xCoord(pt)+half yCoord(pt)+half)))
   pin=dbCreatePin(net fig)
   unless(pin dbSave(cv) error("Failed pin"))
   dbCreateLabel(cv list(cadr(row) "label") pt car(row) "centerCenter" "R0" "stick" 0.1))
  dbSave(cv)
  result=list(cv~>cellName length(cv~>shapes) cv~>bBox cv~>terminals~>name)
  dbClose(cv)
  result))


; Refuse ALL existing targets before creating any cell. No old cell/model edits.
foreach(name list("p2c4_quad_good_r2" "p2c4_quad_open_r2" "p2c4_quad_short_r2") when(ddGetObj("project1" name) error("Refuse existing target: %s" name)))

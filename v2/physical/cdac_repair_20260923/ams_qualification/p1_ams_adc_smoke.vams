`timescale 1ns/1ps
`include "disciplines.vams"

// Compiled in school AMS; actual ADC run blocked at first-acquisition numerics.
// Resolve sensor_adc_candidate and sensor_phases
// to audited real PDK transistor subcircuits; never add dummy/behavioral stubs.
module p1_ams_adc_smoke;
  electrical vdd,vss,ip_source,in_source,inp,inn,rp_source,rn_source,rp,rn,vcm;
  electrical q_e,qb_e,sample_cmd_e,top_e,topb_e,acq_e,conv_e,eval_e;
  electrical [11:0] trial_e;
  wire clk,rst_n,start,ready,busy,data_valid,sample_en,comparator_evaluate;
  wire [1:0] gain_sel,stimulus_sel,data_gain,gain_latched;
  wire [11:0] data,trial_code,trial_fb,trial_fb_valid;
  wire cmp_q,cmp_qb,cmp_q_valid,cmp_qb_valid;
  wire sample_fb,sample_fb_valid,eval_fb,eval_fb_valid;

  analog begin
    V(vss) <+ 0.0;
    V(vdd,vss) <+ 1.8;
    V(vcm,vss) <+ 0.9;
    V(rp_source,vss) <+ 1.1;
    V(rn_source,vss) <+ 0.7;
    I(rp_source,rp) <+ V(rp_source,rp)/1.0;
    I(rn_source,rn) <+ V(rn_source,rn)/1.0;
    I(rp,vss) <+ 10n*ddt(V(rp,vss));
    I(rn,vss) <+ 10n*ddt(V(rn,vss));
    V(ip_source,vss) <+ transition(0.9+((stimulus_sel==0)?-0.399:0.399)/2.0,0,1n,1n);
    V(in_source,vss) <+ transition(0.9-((stimulus_sel==0)?-0.399:0.399)/2.0,0,1n,1n);
    I(ip_source,inp) <+ V(ip_source,inp)/350.0;
    I(in_source,inn) <+ V(in_source,inn)/350.0;
  end

  sar_controller dut(.clk(clk),.rst_n(rst_n),.start(start),.gain_sel(gain_sel),
    .comparator_bit(cmp_q),.ready(ready),.busy(busy),.data_valid(data_valid),
    .data(data),.data_gain(data_gain),.gain_latched(gain_latched),
    .sample_en(sample_en),.trial_code(trial_code),.comparator_evaluate(comparator_evaluate));
  p1_e2l from_q(q_e,vdd,vss,cmp_q,cmp_q_valid);
  p1_e2l from_qb(qb_e,vdd,vss,cmp_qb,cmp_qb_valid);
  p1_l2e drive_sample(sample_en,sample_cmd_e,vdd,vss);
  p1_e2l read_sample(sample_cmd_e,vdd,vss,sample_fb,sample_fb_valid);
  p1_l2e drive_eval(comparator_evaluate,eval_e,vdd,vss);
  p1_e2l read_eval(eval_e,vdd,vss,eval_fb,eval_fb_valid);
  p1_l2e drive_b0(trial_code[0],trial_e[0],vdd,vss);
  p1_e2l read_b0(trial_e[0],vdd,vss,trial_fb[0],trial_fb_valid[0]);
  p1_l2e drive_b1(trial_code[1],trial_e[1],vdd,vss);
  p1_e2l read_b1(trial_e[1],vdd,vss,trial_fb[1],trial_fb_valid[1]);
  p1_l2e drive_b2(trial_code[2],trial_e[2],vdd,vss);
  p1_e2l read_b2(trial_e[2],vdd,vss,trial_fb[2],trial_fb_valid[2]);
  p1_l2e drive_b3(trial_code[3],trial_e[3],vdd,vss);
  p1_e2l read_b3(trial_e[3],vdd,vss,trial_fb[3],trial_fb_valid[3]);
  p1_l2e drive_b4(trial_code[4],trial_e[4],vdd,vss);
  p1_e2l read_b4(trial_e[4],vdd,vss,trial_fb[4],trial_fb_valid[4]);
  p1_l2e drive_b5(trial_code[5],trial_e[5],vdd,vss);
  p1_e2l read_b5(trial_e[5],vdd,vss,trial_fb[5],trial_fb_valid[5]);
  p1_l2e drive_b6(trial_code[6],trial_e[6],vdd,vss);
  p1_e2l read_b6(trial_e[6],vdd,vss,trial_fb[6],trial_fb_valid[6]);
  p1_l2e drive_b7(trial_code[7],trial_e[7],vdd,vss);
  p1_e2l read_b7(trial_e[7],vdd,vss,trial_fb[7],trial_fb_valid[7]);
  p1_l2e drive_b8(trial_code[8],trial_e[8],vdd,vss);
  p1_e2l read_b8(trial_e[8],vdd,vss,trial_fb[8],trial_fb_valid[8]);
  p1_l2e drive_b9(trial_code[9],trial_e[9],vdd,vss);
  p1_e2l read_b9(trial_e[9],vdd,vss,trial_fb[9],trial_fb_valid[9]);
  p1_l2e drive_b10(trial_code[10],trial_e[10],vdd,vss);
  p1_e2l read_b10(trial_e[10],vdd,vss,trial_fb[10],trial_fb_valid[10]);
  p1_l2e drive_b11(trial_code[11],trial_e[11],vdd,vss);
  p1_e2l read_b11(trial_e[11],vdd,vss,trial_fb[11],trial_fb_valid[11]);

  sensor_phases phases(.SAMPLE_CMD(sample_cmd_e),.TOP(top_e),.TOPB(topb_e),
    .ACQ(acq_e),.CONV(conv_e),.VDD(vdd),.VSS(vss));
  sensor_adc_candidate adc(.INP(inp),.INN(inn),.Q(q_e),.QB(qb_e),
    .SAMPLE(top_e),.SAMPLEB(topb_e),.ACQ(acq_e),.CONV(conv_e),.EVAL(eval_e),
    .B11(trial_e[11]),.B10(trial_e[10]),.B9(trial_e[9]),.B8(trial_e[8]),.B7(trial_e[7]),.B6(trial_e[6]),.B5(trial_e[5]),.B4(trial_e[4]),.B3(trial_e[3]),.B2(trial_e[2]),.B1(trial_e[1]),.B0(trial_e[0]),
    .RP(rp),.RN(rn),.VCM(vcm),.VDD(vdd),.VSS(vss));

  p1_ams_sequence seq(.clk(clk),.rst_n(rst_n),.start(start),.gain_sel(gain_sel),
    .stimulus_sel(stimulus_sel),.ready(ready),.busy(busy),.data_valid(data_valid),
    .sample_en(sample_en),.comparator_evaluate(comparator_evaluate),
    .data(data),.trial_code(trial_code),.data_gain(data_gain),.gain_latched(gain_latched),
    .cmp_q(cmp_q),.cmp_qb(cmp_qb),.cmp_q_valid(cmp_q_valid),.cmp_qb_valid(cmp_qb_valid),
    .trial_fb(trial_fb),.trial_fb_valid(trial_fb_valid),.sample_fb(sample_fb),
    .sample_fb_valid(sample_fb_valid),.eval_fb(eval_fb),.eval_fb_valid(eval_fb_valid));
endmodule

XPGA VINP VINN COREP COREN VDD VSS VCM SEL0 SEL1 sky130_v2_switchable_pga
XRIP COREP OUTP VSS frontend_r R={RISO}
XRIN COREN OUTN VSS frontend_r R={RISO}

* Frozen redesign TT diagnostic: all gains, real sampler
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.include candidate_snapshot.spice
.include adc_blocks_snapshot.spice
.include sampling_switch_snapshot.spice
.temp 27
.options reltol=1e-5 abstol=1e-14 vntol=1e-8 itl1=300 itl2=300 method=gear maxord=2 klu
VSW SW 0 PULSE(-.36 .36 10u 10n 10n 10u 20u)
VACQ ACQ 0 PULSE(0 1.8 10u 10n 10n 2.476847754e-06 10u)
VACQB ACQB 0 PULSE(1.8 0 10u 10n 10n 2.476847754e-06 10u)
* Explicit finite-slope PWL reset edges avoid a periodic-source breakpoint
* pathology seen at exactly 8.01 us.  Voltage levels, 10 ns edges, 1 us high
* time, and 10 us repetition are unchanged from the frozen stimulus.
VRST RST 0 PWL(0 0 8u 0 8.01u 1.8 9.01u 1.8 9.02u 0 18u 0 18.01u 1.8 19.01u 1.8 19.02u 0 28u 0 28.01u 1.8 29.01u 1.8 29.02u 0 38u 0 38.01u 1.8 39.01u 1.8 39.02u 0 40u 0)
VRSTB RSTB 0 PWL(0 1.8 8u 1.8 8.01u 0 9.01u 0 9.02u 1.8 18u 1.8 18.01u 0 19.01u 0 19.02u 1.8 28u 1.8 28.01u 0 29.01u 0 29.02u 1.8 38u 1.8 38.01u 0 39.01u 0 39.02u 1.8 40u 1.8)
.global SW ACQ ACQB RST RSTB

.subckt rd_case params: SUP=1.8 G=4 S0=1.8 S1=0
VDDC VDD 0 {SUP}
VCMC VCM 0 {SUP/2}
BSP SP 0 V={SUP/2+V(SW)/(2*G)}
BSN SN 0 V={SUP/2-V(SW)/(2*G)}
RSP SP IP 350
RSN SN IN 350
VSEL0 SEL0 0 {S0}
VSEL1 SEL1 0 {S1}
XDUT IP IN COREP COREN VDD 0 VCM SEL0 SEL1 sky130_v2_switchable_pga

* Same real isolation/filter and 4096-unit ADC sampling load for every gain.
XRIP COREP FILTP 0 rd_hr R=1800
XRIN COREN FILTN 0 rd_hr R=1800
XCFP FILTP 0 rd_c4p
XCFN FILTN 0 rd_c4p
XTGP FILTP HP ACQ ACQB VDD 0 rd_sampling_tgate
XTGN FILTN HN ACQ ACQB VDD 0 rd_sampling_tgate
XCP HP VCM adc_mim_bank COUNT=4096
XCN HN VCM adc_mim_bank COUNT=4096
XRSTP VCM HP RST RSTB VDD 0 rd_sampling_tgate
XRSTN VCM HN RST RSTB VDD 0 rd_sampling_tgate
RLEAKP HP VCM 1g
RLEAKN HN VCM 1g
.ends rd_case

XG1 rd_case SUP=1.8 G=1 S0=0 S1=0
XG4 rd_case SUP=1.8 G=4 S0=1.8 S1=0
XG16 rd_case SUP=1.8 G=16 S0=0 S1=1.8
.control
set noaskquit
set num_threads=1
set wr_singlescale
set wr_vecnames
set numdgt=12
op

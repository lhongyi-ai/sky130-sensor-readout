XRIN_g1_stage1_cm ON_g1_stage1_cm FN_g1_stage1_cm 0 rd_hr R=1500
XCFP_g1_stage1_cm FP_g1_stage1_cm 0 rd_c4p
XCFN_g1_stage1_cm FN_g1_stage1_cm 0 rd_c4p

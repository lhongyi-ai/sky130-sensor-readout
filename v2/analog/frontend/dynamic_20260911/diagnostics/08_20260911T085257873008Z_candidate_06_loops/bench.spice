* Formal loop injection: three isolated measurement copies per gain
.lib /foss/pdks/sky130A/libs.tech/combined/sky130.lib.spice tt
.include measurement_injections.spice
.include adc_blocks_snapshot.spice
.include sampling_switch_snapshot.spice
.temp 27
.options reltol=1e-6 abstol=1e-14 vntol=1e-9 chgtol=1e-18 method=gear maxord=2 klu
VDD VDD 0 1.8
VCM VCM 0 .9
VINP VINP 0 .9
VINN VINN 0 .9
VACQ ACQ 0 1.8
VACQB ACQB 0 0
VSEL0_1 SEL0_1 0 0
VSEL1_1 SEL1_1 0 0
RSP_g1_dm VINP IP_g1_dm 350
RSN_g1_dm VINN IN_g1_dm 350
XPGA_g1_dm IP_g1_dm IN_g1_dm OP_g1_dm ON_g1_dm VDD 0 VCM SEL0_1 SEL1_1 sky130_v2_switchable_pga DMAC=1 NCMAC=0 OCMAC=0
XRIP_g1_dm OP_g1_dm FP_g1_dm 0 rd_hr R=1500
XRIN_g1_dm ON_g1_dm FN_g1_dm 0 rd_hr R=1500
XCFP_g1_dm FP_g1_dm 0 rd_c4p
XCFN_g1_dm FN_g1_dm 0 rd_c4p
XTGP_g1_dm FP_g1_dm HP_g1_dm ACQ ACQB VDD 0 rd_sampling_tgate
XTGN_g1_dm FN_g1_dm HN_g1_dm ACQ ACQB VDD 0 rd_sampling_tgate
XCP_g1_dm HP_g1_dm VCM adc_mim_bank COUNT=4096
XCN_g1_dm HN_g1_dm VCM adc_mim_bank COUNT=4096
RLEAKP_g1_dm HP_g1_dm VCM 1g
RLEAKN_g1_dm HN_g1_dm VCM 1g

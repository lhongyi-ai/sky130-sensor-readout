RLEAKN_g4_output_cm HN_g4_output_cm VCM 1g
VSEL0_16 SEL0_16 0 0
VSEL1_16 SEL1_16 0 1.8
RSP_g16_dm VINP IP_g16_dm 350
RSN_g16_dm VINN IN_g16_dm 350
XPGA_g16_dm IP_g16_dm IN_g16_dm OP_g16_dm ON_g16_dm VDD 0 VCM SEL0_16 SEL1_16 sky130_v2_switchable_pga DMAC=1 NCMAC=0 OCMAC=0
XRIP_g16_dm OP_g16_dm FP_g16_dm 0 rd_hr R=1500
XRIN_g16_dm ON_g16_dm FN_g16_dm 0 rd_hr R=1500
XCFP_g16_dm FP_g16_dm 0 rd_c4p
XCFN_g16_dm FN_g16_dm 0 rd_c4p

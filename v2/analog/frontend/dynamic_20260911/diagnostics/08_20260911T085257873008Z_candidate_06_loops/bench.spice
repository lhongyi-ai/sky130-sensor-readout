RLEAKN_g16_output_cm HN_g16_output_cm VCM 1g
.control
set noaskquit
set num_threads=1
set wr_singlescale
set wr_vecnames
set numdgt=12
op
ac dec 100 1 1g
let g1_dm=-(v(xpga_g1_dm.sumpos)-v(xpga_g1_dm.sumneg))/(v(xpga_g1_dm.i_sumpos)-v(xpga_g1_dm.i_sumneg))
let g1_dm_r=real(g1_dm)
let g1_dm_i=imag(g1_dm)
let g1_stage1_cm=-v(xpga_g1_stage1_cm.xota.ncm)/v(xpga_g1_stage1_cm.xota.ncm_gate)
let g1_stage1_cm_r=real(g1_stage1_cm)
let g1_stage1_cm_i=imag(g1_stage1_cm)
let g1_output_cm=-v(xpga_g1_output_cm.xota.cms)/v(xpga_g1_output_cm.xota.cms_error)
let g1_output_cm_r=real(g1_output_cm)
let g1_output_cm_i=imag(g1_output_cm)
let g4_dm=-(v(xpga_g4_dm.sumpos)-v(xpga_g4_dm.sumneg))/(v(xpga_g4_dm.i_sumpos)-v(xpga_g4_dm.i_sumneg))
let g4_dm_r=real(g4_dm)
let g4_dm_i=imag(g4_dm)
let g4_stage1_cm=-v(xpga_g4_stage1_cm.xota.ncm)/v(xpga_g4_stage1_cm.xota.ncm_gate)
let g4_stage1_cm_r=real(g4_stage1_cm)
let g4_stage1_cm_i=imag(g4_stage1_cm)
let g4_output_cm=-v(xpga_g4_output_cm.xota.cms)/v(xpga_g4_output_cm.xota.cms_error)
let g4_output_cm_r=real(g4_output_cm)
let g4_output_cm_i=imag(g4_output_cm)
let g16_dm=-(v(xpga_g16_dm.sumpos)-v(xpga_g16_dm.sumneg))/(v(xpga_g16_dm.i_sumpos)-v(xpga_g16_dm.i_sumneg))
let g16_dm_r=real(g16_dm)
let g16_dm_i=imag(g16_dm)
let g16_stage1_cm=-v(xpga_g16_stage1_cm.xota.ncm)/v(xpga_g16_stage1_cm.xota.ncm_gate)
let g16_stage1_cm_r=real(g16_stage1_cm)
let g16_stage1_cm_i=imag(g16_stage1_cm)
let g16_output_cm=-v(xpga_g16_output_cm.xota.cms)/v(xpga_g16_output_cm.xota.cms_error)
let g16_output_cm_r=real(g16_output_cm)
let g16_output_cm_i=imag(g16_output_cm)
wrdata loops.dat g1_dm_r g1_dm_i g1_stage1_cm_r g1_stage1_cm_i g1_output_cm_r g1_output_cm_i g4_dm_r g4_dm_i g4_stage1_cm_r g4_stage1_cm_i g4_output_cm_r g4_output_cm_i g16_dm_r g16_dm_i g16_stage1_cm_r g16_stage1_cm_i g16_output_cm_r g16_output_cm_i
quit
.endc
.end
